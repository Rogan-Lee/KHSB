{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- .",
  "redirects": [
    { "source": "/go/:source", "destination": "/?utm_source=:source&utm_medium=link", "permanent": false },
    { "source": "/go/:source/:page", "destination": "/:page.html?utm_source=:source&utm_medium=link", "permanent": false }
  ],
  "rewrites": [
    { "source": "/", "destination": "/landing.html" },
    { "source": "/index.html", "destination": "/landing.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/support", "destination": "/support.html" },
    { "source": "/terms", "destination": "/terms.html" }
  ]
}
